<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentCabinet.ViewModels"
             x:Class="StudentCabinet.MainPage"
             Title="Особистий кабінет студента">

    <ContentPage.BindingContext>
        <vm:StudentViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="12">

        <Entry Text="{Binding FullName, Mode=TwoWay}" Placeholder="ПІБ студента" />
        <Entry Text="{Binding Group, Mode=TwoWay}" Placeholder="Група" />

        <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0:F1}'}" />
        <Slider Minimum="0" Maximum="5"
                Value="{Binding AverageScore, Mode=TwoWay}" />

        <Label Text="{Binding Greeting, Mode=OneWay}"
               FontSize="18" TextColor="Gray">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsGoodScore}" Value="True">
                    <Setter Property="TextColor" Value="Green" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Button Text="Додати студента"
                Command="{Binding AddStudentCommand}" />

        <CollectionView ItemsSource="{Binding Students}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="0,6">
                        <Label Text="{Binding FullName}" FontAttributes="Bold" />
                        <Label Text="{Binding Group, StringFormat='Група: {0}'}" />
                        <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F1}'}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
        </Label>

    </VerticalStackLayout>
</ContentPage>